<section class="service-strip section-spacing">
  <div class="container service-strip__grid">
    {% for block in section.blocks %}
      <div class="service-item" {{ block.shopify_attributes }}><span class="service-item__number">0{{ forloop.index }}</span><div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></div></div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Service-Vorteile",
  "max_blocks": 4,
  "settings": [],
  "blocks": [{
    "type": "benefit",
    "name": "Vorteil",
    "settings": [
      { "type": "text", "id": "heading", "label": "Titel", "default": "Echte Beratung" },
      { "type": "text", "id": "text", "label": "Text", "default": "Von Menschen, die selbst fahren." }
    ]
  }],
  "presets": [{ "name": "Service-Vorteile", "blocks": [{ "type": "benefit", "settings": { "heading": "Echte Beratung", "text": "Von Menschen, die selbst fahren." } }, { "type": "benefit", "settings": { "heading": "Schneller Versand", "text": "Direkt aus unserem Lager." } }, { "type": "benefit", "settings": { "heading": "30 Tage testen", "text": "Einfach und transparent zurückgeben." } }] }]
}
{% endschema %}
