<section class="cart-page section-spacing">
  <div class="container container--narrow">
    <div class="section-heading"><h1>Dein Warenkorb</h1><a class="text-link" href="{{ routes.all_products_collection_url }}">Weiter einkaufen ↗</a></div>
    {% if cart.empty? %}
      <div class="empty-section"><h2>Dein Warenkorb ist noch leer.</h2><a class="button button--accent" href="{{ routes.all_products_collection_url }}">Produkte entdecken</a></div>
    {% else %}
      <form action="{{ routes.cart_url }}" method="post">
        <div class="cart-items">
          {% for item in cart.items %}
            <div class="cart-item">
              <a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.title }}{% endif %}</a>
              <div><p class="eyebrow">{{ item.product.vendor }}</p><h2><a href="{{ item.url }}">{{ item.product.title }}</a></h2>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}<a class="text-link" href="{{ item.url_to_remove }}">Entfernen</a></div>
              <div class="cart-item__quantity"><label for="Quantity-{{ item.index | plus: 1 }}">Menge</label><input id="Quantity-{{ item.index | plus: 1 }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div>
              <strong>{{ item.final_line_price | money }}</strong>
            </div>
          {% endfor %}
        </div>
        <div class="cart-summary"><div><span>Zwischensumme</span><strong>{{ cart.total_price | money }}</strong></div><p>Versand und Steuern werden beim Checkout berechnet.</p><button class="button button--accent button--wide" type="submit" name="checkout">Zur Kasse</button><button class="text-button" type="submit" name="update">Warenkorb aktualisieren</button></div>
      </form>
    {% endif %}
  </div>
</section>

{% schema %}
{ "name": "Warenkorb", "settings": [] }
{% endschema %}
