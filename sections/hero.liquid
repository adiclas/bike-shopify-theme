<section class="hero">
  <div class="hero__image{% if section.settings.image == blank %} hero__image--empty{% endif %}"{% if section.settings.image != blank %} style="background-image:url('{{ section.settings.image | image_url: width: 2400 }}')"{% endif %}>
    <div class="container hero__content">
      <p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      <p class="hero__sub">{{ section.settings.subheading }}</p>
      <a class="hero__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }} <span>↗</span></a>
    </div>
  </div>
  <div class="hero__quickbar">
    <div class="hero__quickbar-inner">
      {% for block in section.blocks %}
        {% assign is_banner = block.settings.use_as_banner %}
        <a class="quick-card{% if block.settings.image == blank %} quick-card--empty{% endif %}{% if is_banner %} quick-card--banner{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <div class="quick-card__media">{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', alt: block.settings.label }}</div>
            {% unless is_banner %}<div class="quick-card__overlay"></div>{% endunless %}
          {% endif %}
          {% unless is_banner %}
            <div class="quick-card__content">
              <span class="quick-card__label">{{ block.settings.label }}</span>
              <span class="quick-card__title">{{ block.settings.heading }}</span>
              <span class="quick-card__text">{{ block.settings.text }}</span>
            </div>
          {% endunless %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "max_blocks": 3,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hintergrund" },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Big Sale" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Bikes" },
    { "type": "text", "id": "subheading", "label": "Untertitel", "default": "Big Sale this Summer · Extra 30 %" },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Jetzt einkaufen" },
    { "type": "url", "id": "cta_link", "label": "Button-Link" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Quick Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Hintergrundbild" },
        { "type": "text", "id": "label", "label": "Label", "default": "Men" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "$50" },
        { "type": "text", "id": "text", "label": "Text", "default": "Basic Clothes & Activewear" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "use_as_banner", "label": "Als Banner verwenden", "default": false, "info": "Wenn aktiv, werden Label, Titel, Text und Overlay ausgeblendet." }
      ]
    }
  ],
  "presets": [{
    "name": "Hero",
    "blocks": [
      { "type": "card", "settings": { "label": "Men", "heading": "$50", "text": "Basic Clothes & Activewear" } },
      { "type": "card", "settings": { "label": "Women", "heading": "$59", "text": "Dress, Clothing, Activewear" } },
      { "type": "card", "settings": { "label": "Bike's", "heading": "$200", "text": "Have a Faster Experience" } }
    ]
  }]
}
{% endschema %}
