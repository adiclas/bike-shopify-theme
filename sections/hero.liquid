<section class="hero section-spacing">
  <div class="container">
    <div class="hero__visual{% if section.settings.image == blank %} hero__visual--empty{% endif %}"{% if section.settings.image != blank %} style="background-image:url('{{ section.settings.image | image_url: width: 2400 }}')"{% endif %}>
      <div class="hero__content">
        {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
        <h1>{{ section.settings.heading }}</h1>
        {% if section.settings.text != blank %}<div class="hero__text">{{ section.settings.text }}</div>{% endif %}
        <div class="button-row">
          {% if section.settings.primary_label != blank %}<a class="button button--accent" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>{% endif %}
          {% if section.settings.secondary_label != blank %}<a class="button button--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>{% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "eyebrow", "label": "Kicker", "default": "Für deinen nächsten Ride" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Ride further. Feel more." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ausgewählte Bikes, Ausrüstung und Know-how für alle Wege, die vor dir liegen.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primärer Button", "default": "Bikes entdecken" },
    { "type": "url", "id": "primary_link", "label": "Primärer Link" },
    { "type": "text", "id": "secondary_label", "label": "Sekundärer Button", "default": "Sale ansehen" },
    { "type": "url", "id": "secondary_link", "label": "Sekundärer Link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
