<section class="brand-strip section-spacing">
  <div class="container brand-strip__grid">
    {% for block in section.blocks %}
      <a class="brand-strip__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '120,240,360', alt: block.settings.name, class: 'brand-strip__image' }}
        {% else %}
          <span>{{ block.settings.name }}</span>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Marken-Strip",
  "max_blocks": 8,
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Marke",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Name (Fallback / Alt-Text)", "default": "Brand" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Marken-Strip",
    "blocks": [
      { "type": "brand", "settings": { "name": "Brand" } },
      { "type": "brand", "settings": { "name": "Brand" } },
      { "type": "brand", "settings": { "name": "Brand" } },
      { "type": "brand", "settings": { "name": "Brand" } },
      { "type": "brand", "settings": { "name": "Brand" } },
      { "type": "brand", "settings": { "name": "Brand" } }
    ]
  }]
}
{% endschema %}
