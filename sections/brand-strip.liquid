<section class="brand-strip section-spacing">
  <div class="container brand-strip__grid">
    {% for block in section.blocks %}
      <a class="brand-strip__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><span>{{ block.settings.name }}</span></a>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Marken-Strip",
  "max_blocks": 8,
  "settings": [],
  "blocks": [
    {
      "type": "brand",
      "name": "Marke",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Brand" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Marken-Strip",
    "blocks": [
      { "type": "brand", "settings": { "name": "Cervélo" } },
      { "type": "brand", "settings": { "name": "Trek" } },
      { "type": "brand", "settings": { "name": "Giant" } },
      { "type": "brand", "settings": { "name": "Focus" } },
      { "type": "brand", "settings": { "name": "Norco" } },
      { "type": "brand", "settings": { "name": "Ghost" } }
    ]
  }]
}
{% endschema %}
