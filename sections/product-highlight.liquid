<section class="product-highlight">
  <div class="container product-highlight__inner">
    <header class="product-highlight__head">
      <svg class="product-highlight__icon" viewBox="0 0 64 40" width="48" height="30" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
        <circle cx="32" cy="20" r="10"></circle>
        <path d="M2 20h12M50 20h12M22 6l-4 8M42 6l4 8M22 34l-4-8M42 34l4-8"></path>
      </svg>
      <h2 class="product-highlight__title">CARBON FIBER <span class="accent">{{ section.settings.brand }}</span></h2>
      <p class="product-highlight__sub">{{ section.settings.subtitle }}</p>
    </header>
    <ul class="product-highlight__stats">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          <li {{ block.shopify_attributes }}><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></li>
        {% endif %}
      {% endfor %}
    </ul>
    <div class="product-highlight__stage">
      {% if section.settings.rider_image != blank %}
        <div class="product-highlight__rider">{{ section.settings.rider_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350,550,700', alt: section.settings.brand }}</div>
      {% endif %}
      {% if section.settings.bike_image != blank %}
        <div class="product-highlight__bike">
          {{ section.settings.bike_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700,1000,1400', alt: section.settings.brand }}
          {% for block in section.blocks %}
            {% if block.type == 'hotspot' %}
              {% assign side = block.settings.side %}
              <span class="product-highlight__hotspot" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%;" {{ block.shopify_attributes }}></span>
              <span class="product-highlight__label product-highlight__label--{{ side }}" style="left:{{ block.settings.x }}%;top:{{ block.settings.y }}%;">
                <em class="product-highlight__label-line"></em>
                <span>{{ block.settings.text }}</span>
              </span>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <div class="product-highlight__bike product-highlight__bike--empty"></div>
      {% endif %}
    </div>
    <div class="product-highlight__buy">
      <span class="product-highlight__priceline"></span>
      <p class="product-highlight__price"><span>Price:</span><strong>${{ section.settings.price }}</strong><s>${{ section.settings.compare_at_price }}</s></p>
      <a class="button button--accent button--wide" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produkt-Highlight",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "brand", "label": "Marke (im Titel)", "default": "CERVELO" },
    { "type": "text", "id": "subtitle", "label": "Untertitel", "default": "Limited time offer only on Go Shop" },
    { "type": "image_picker", "id": "bike_image", "label": "Bike-Bild" },
    { "type": "image_picker", "id": "rider_image", "label": "Reiter-Bild (rechts)" },
    { "type": "text", "id": "price", "label": "Preis", "default": "1150" },
    { "type": "text", "id": "compare_at_price", "label": "Streichpreis", "default": "1850" },
    { "type": "url", "id": "cta_link", "label": "Button-Link" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Add to cart" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistik",
      "settings": [
        { "type": "text", "id": "value", "label": "Wert", "default": "956" },
        { "type": "text", "id": "label", "label": "Label", "default": "Frames" }
      ]
    },
    {
      "type": "hotspot",
      "name": "Callout",
      "settings": [
        { "type": "select", "id": "side", "label": "Label-Seite", "options": [{ "value": "left", "label": "Links" }, { "value": "right", "label": "Rechts" }], "default": "right" },
        { "type": "range", "id": "x", "label": "X % (Punkt)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "range", "id": "y", "label": "Y % (Punkt)", "min": 0, "max": 100, "step": 1, "default": 50 },
        { "type": "text", "id": "text", "label": "Text", "default": "Lightweight" }
      ]
    }
  ],
  "presets": [{
    "name": "Produkt-Highlight",
    "blocks": [
      { "type": "stat", "settings": { "value": "956", "label": "Frames" } },
      { "type": "stat", "settings": { "value": "1215", "label": "Frames" } },
      { "type": "stat", "settings": { "value": "3126", "label": "Powert" } },
      { "type": "stat", "settings": { "value": "5265", "label": "Cross" } },
      { "type": "hotspot", "settings": { "x": 12, "y": 50, "text": "Lightweight" } },
      { "type": "hotspot", "settings": { "x": 32, "y": 18, "text": "Fluid Cable Management" } },
      { "type": "hotspot", "settings": { "x": 62, "y": 8, "text": "Dialed Geometry Design" } },
      { "type": "hotspot", "settings": { "x": 78, "y": 78, "text": "Advanced Seatpost" } }
    ]
  }]
}
{% endschema %}
