<section class="section-spacing">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">Finde deinen Weg</p><h2>{{ section.settings.heading }}</h2></div></div>
    <div class="category-grid">
      {% for block in section.blocks %}
        <a class="category-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,600,1000', alt: block.settings.heading }}{% else %}<div class="category-card__placeholder"></div>{% endif %}
          <div class="category-card__content"><span>{{ block.settings.kicker }}</span><h3>{{ block.settings.heading }}</h3><b>Entdecken ↗</b></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategorien",
  "max_blocks": 6,
  "settings": [{ "type": "text", "id": "heading", "label": "Überschrift", "default": "Was willst du fahren?" }],
  "blocks": [{
    "type": "category",
    "name": "Kategorie",
    "settings": [
      { "type": "image_picker", "id": "image", "label": "Bild" },
      { "type": "text", "id": "kicker", "label": "Kicker", "default": "Explore" },
      { "type": "text", "id": "heading", "label": "Titel", "default": "Mountainbikes" },
      { "type": "url", "id": "link", "label": "Link" }
    ]
  }],
  "presets": [{ "name": "Kategorien", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
