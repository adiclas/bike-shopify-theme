{% assign collection = section.settings.collection %}
<section class="section-spacing section--light">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">Ausgewählt für dich</p><h2>{{ section.settings.heading }}</h2></div>{% if collection != blank %}<a class="text-link" href="{{ collection.url }}">Alle anzeigen <span>↗</span></a>{% endif %}</div>
    {% if collection != blank and collection.products_count > 0 %}
      <div class="product-grid product-grid--{{ section.settings.columns }}">{% for product in collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product %}{% endfor %}</div>
    {% else %}
      <div class="empty-section"><p>Wähle im Theme-Editor eine Kollektion aus.</p></div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Produktkollektion",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Highlights" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "products_to_show", "label": "Produkte", "min": 4, "max": 12, "step": 4, "default": 8 },
    { "type": "select", "id": "columns", "label": "Spalten", "options": [{ "value": "4", "label": "4" }, { "value": "3", "label": "3" }], "default": "4" }
  ],
  "presets": [{ "name": "Produktkollektion" }]
}
{% endschema %}
