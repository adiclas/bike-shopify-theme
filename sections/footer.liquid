<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__col">
      <a class="site-logo site-logo--footer" href="{{ routes.root_url }}">
        <span class="site-logo__mark">↗</span>
        <span class="site-logo__text"><strong>{{ section.settings.logo_top }}</strong><em>{{ section.settings.logo_sub }}</em></span>
      </a>
      <p>{{ section.settings.description }}</p>
    </div>
    {% for block in section.blocks %}
      <div class="site-footer__col" {{ block.shopify_attributes }}>
        <h3>{{ block.settings.heading }}</h3>
        {% if block.settings.menu != blank %}
          <ul>
            {% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endfor %}
  </div>
  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }} · Theme: Trailbound</span>
      <div class="site-footer__payments">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "logo_top", "label": "Logo (Teil 1)", "default": "GoShop" },
    { "type": "text", "id": "logo_sub", "label": "Logo (Teil 2)", "default": "Bikes" },
    { "type": "textarea", "id": "description", "label": "Beschreibung", "default": "Customer service is our passion, available Mon–Fri." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menüspalte",
      "settings": [
        { "type": "text", "id": "heading", "label": "Titel", "default": "Service" },
        { "type": "link_list", "id": "menu", "label": "Menü" }
      ]
    }
  ]
}
{% endschema %}
