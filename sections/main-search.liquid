<section class="search-page section-spacing"><div class="container"><header class="collection-header"><p class="eyebrow">Suche</p><h1>{% if search.performed %}Ergebnisse für „{{ search.terms }}“{% else %}Was suchst du?{% endif %}</h1><form class="search-page__form" action="{{ routes.search_url }}" method="get"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Bikes, Komponenten, Marken …"><button class="button button--accent" type="submit">Suchen</button></form></header>{% if search.performed %}{% paginate search.results by 24 %}<div class="product-grid product-grid--4">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% else %}<p>Keine Ergebnisse gefunden.</p>{% endfor %}</div>{% if paginate.pages > 1 %}<nav class="pagination">{{ paginate | default_pagination }}</nav>{% endif %}{% endpaginate %}{% endif %}</div></section>
{% schema %}
{ "name": "Suche", "settings": [] }
{% endschema %}
