<section class="section-spacing men-women">
  <div class="container men-women__row">
    {% for block in section.blocks %}
      <article class="men-women__card men-women__card--{{ block.settings.side }}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          <div class="men-women__image">{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700,1000,1400', alt: block.settings.heading }}</div>
        {% else %}
          <div class="men-women__image men-women__image--empty"></div>
        {% endif %}
        <div class="men-women__content">
          <p class="men-women__eyebrow">{{ block.settings.eyebrow }}</p>
          <h3 class="men-women__heading">{{ block.settings.heading }} <span class="accent">${{ block.settings.price }}</span></h3>
          {% if block.settings.bullets != blank %}
            <ul class="men-women__list">
              {% for line in block.settings.bullets %}<li>{{ line }}</li>{% endfor %}
            </ul>
          {% endif %}
          <div class="men-women__actions">
            <a class="men-women__btn" href="{{ block.settings.detail_link }}">Detail</a>
            <a class="men-women__btn men-women__btn--accent" href="{{ block.settings.cart_link }}">Add to cart</a>
          </div>
        </div>
      </article>
    {% endfor %}
    <div class="men-women__divider" aria-hidden="true">{{ section.settings.divider_text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Men & Women",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "divider_text", "label": "Text im Mittelstreifen", "default": "DISCOUNT UPTO75%" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Karte",
      "settings": [
        { "type": "select", "id": "side", "label": "Ausrichtung", "options": [{ "value": "left", "label": "Bild links" }, { "value": "right", "label": "Bild rechts" }], "default": "left" },
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Waterproof Jacket" },
        { "type": "text", "id": "heading", "label": "Titel", "default": "Men" },
        { "type": "text", "id": "price", "label": "Preis", "default": "300" },
        { "type": "textarea", "id": "bullets", "label": "Bullet Points (eine Zeile pro Punkt)", "default": "Integrated 1-Lumen LED rear light\nOptional hood available separately\nBreathability rating 15,000" },
        { "type": "url", "id": "detail_link", "label": "Detail-Link" },
        { "type": "url", "id": "cart_link", "label": "Add-to-cart-Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Men & Women",
    "blocks": [
      { "type": "card", "settings": { "side": "left", "heading": "Men", "price": "350", "eyebrow": "Waterproof Jacket" } },
      { "type": "card", "settings": { "side": "right", "heading": "Women", "price": "250", "eyebrow": "Waterproof Jacket" } }
    ]
  }]
}
{% endschema %}
