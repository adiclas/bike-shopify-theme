<header class="site-header" data-header>
  <div class="announcement-bar">
    <div class="container announcement-bar__inner">
      <span>{{ section.settings.announcement }}</span>
      <dl class="announcement-bar__meta">
        <div><dt>Welcome</dt><dd>to Bike Mailorder</dd></div>
        <div><dt>Call Us</dt><dd>0 800 555 1234</dd></div>
        <div><dt>Email</dt><dd>support@bikemailorder.test</dd></div>
      </dl>
    </div>
  </div>
  <div class="site-header__main">
    <div class="container site-header__row">
      <button class="mobile-menu-button" type="button" aria-expanded="false" aria-controls="MobileNavigation" data-menu-toggle><span></span><span></span><span></span><span class="visually-hidden">Menü öffnen</span></button>
      <a class="site-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {% if section.settings.logo != blank %}
          <img class="site-logo__image" src="{{ section.settings.logo | image_url: width: 360 }}" alt="{{ shop.name | escape }}" width="180" height="40" loading="eager">
        {% else %}
          <span class="site-logo__mark">↗</span>
          <span class="site-logo__text"><strong>{{ section.settings.logo_top }}</strong><em>{{ section.settings.logo_sub }}</em></span>
        {% endif %}
      </a>
      <nav class="site-nav" id="DesktopNavigation" aria-label="Hauptnavigation">
        <ul class="site-nav__list">
          {% for link in section.settings.menu.links %}
            <li><a class="site-nav__link" href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>
      <div class="site-actions">
        <button type="button" class="site-action site-action--favorites" data-favorites-toggle aria-label="Favoriten anzeigen" aria-haspopup="dialog">
          <svg class="site-action__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"></path>
          </svg>
          <span class="site-action__label">Favoriten</span>
          <b class="favorites-count" data-favorites-count hidden>0</b>
        </button>
        <a href="{{ routes.account_url }}" class="site-action">
          <svg class="site-action__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="12" cy="8" r="4"></circle>
            <path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path>
          </svg>
          <span class="site-action__label">Konto</span>
        </a>
        <a href="{{ routes.cart_url }}" class="site-action" data-cart-link>
          <svg class="site-action__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M5 7h14l-1.5 10.2a2 2 0 0 1-2 1.8H8.5a2 2 0 0 1-2-1.8L5 7z"></path>
            <path d="M9 7V5a3 3 0 0 1 6 0v2"></path>
          </svg>
          <span class="site-action__label">Warenkorb</span>
          <b class="cart-count">{{ cart.item_count }}</b>
        </a>
        <button type="button" class="site-action site-action--search" data-search-toggle aria-expanded="false" aria-label="Suche öffnen">
          <svg class="site-action__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </button>
      </div>
    </div>
    <form class="site-search" data-search-form action="{{ routes.search_url }}" method="get" role="search" hidden>
      <div class="container site-search__inner">
        <label class="visually-hidden" for="SiteSearch">{{ section.settings.search_placeholder }}</label>
        <span class="site-search__icon" aria-hidden="true">⌕</span>
        <input id="SiteSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder }}" aria-label="Suchen">
        <button type="submit" class="site-search__submit" aria-label="Suchen">↗</button>
      </div>
    </form>
  </div>
  <div class="mobile-navigation" id="MobileNavigation" data-mobile-navigation>
    <div class="mobile-navigation__head"><strong>Menü</strong><button type="button" data-menu-toggle aria-label="Menü schließen">×</button></div>
    {% for link in section.settings.menu.links %}<a class="mobile-navigation__link" href="{{ link.url }}">{{ link.title }}</a>{% endfor %}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Ankündigung", "default": "Versandkostenfrei ab 99 € · 30 Tage Rückgabe" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "logo_top", "label": "Logo (Teil 1)", "default": "Bike" },
    { "type": "text", "id": "logo_sub", "label": "Logo (Teil 2)", "default": "Mailorder" },
    { "type": "text", "id": "search_placeholder", "label": "Such-Placeholder", "default": "Wonach suchst du?" },
    { "type": "link_list", "id": "menu", "label": "Menü", "default": "main-menu" }
  ]
}
{% endschema %}
