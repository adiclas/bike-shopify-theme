<section class="section-spacing choose-bike">
  <div class="container">
    <header class="section-heading section-heading--center">
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'Find what you need' }}</p>
      <h2>Choose your <span class="accent">{{ section.settings.heading_accent | default: 'bike' }}</span></h2>
      <p class="section-heading__sub">{{ section.settings.subtitle | default: 'Discover the perfect bike for every ride' }}</p>
    </header>

    {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
      <div class="choose-bike__products product-grid product-grid--{{ section.settings.columns }}">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      {% if section.settings.bike_1_collection != blank %}
        <div class="choose-bike__products product-grid product-grid--{{ section.settings.columns }}">
          {% for col in section.blocks %}
            {% if col.settings.collection != blank and col.settings.collection.products_count > 0 %}
              {% assign first = col.settings.collection.products.first %}
              <a class="choose-bike__card" href="{{ col.settings.collection.url }}">
                {% if first.featured_image != blank %}{{ first.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: col.settings.title }}{% endif %}
                <div class="choose-bike__overlay"></div>
                <div class="choose-bike__meta"><span>{{ col.settings.eyebrow }}</span><h3>{{ col.settings.title }}</h3><b>Entdecken ↗</b></div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <div class="choose-bike__grid">
          {% for block in section.blocks %}
            <a class="choose-bike__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: block.settings.title }}{% else %}<div class="choose-bike__placeholder"></div>{% endif %}
              <h3>{{ block.settings.title }}</h3>
              <span>{{ block.settings.subtitle }}</span>
            </a>
          {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    {% if section.settings.show_comparison %}
      <div class="choose-bike__compare">
        <div class="choose-bike__compare-cell"><span class="choose-bike__compare-label">Bike type</span><span class="choose-bike__compare-value">{{ section.settings.compare_type | default: 'Road, MTB, Gravel' }}</span></div>
        <div class="choose-bike__compare-cell"><span class="choose-bike__compare-label">Gewicht</span><span class="choose-bike__compare-value">{{ section.settings.compare_weight | default: 'ab 7,8 kg' }}</span></div>
        <div class="choose-bike__compare-cell"><span class="choose-bike__compare-label">Schaltung</span><span class="choose-bike__compare-value">{{ section.settings.compare_gears | default: '1×11 bis 2×12' }}</span></div>
        <div class="choose-bike__compare-cell"><span class="choose-bike__compare-label">Preis</span><span class="choose-bike__compare-value">{{ section.settings.compare_price | default: 'ab 599 €' }}</span></div>
      </div>
    {% endif %}

    <div class="choose-bike__cta"><a class="button button--accent" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label | default: 'Choose a Bikes' }}</a></div>
  </div>
</section>

{% schema %}
{
  "name": "Bike wählen",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading_accent", "label": "Highlight-Wort nach \"Choose your\"", "default": "bike" },
    { "type": "text", "id": "subtitle", "label": "Untertitel" },
    { "type": "header", "content": "Produkte" },
    { "type": "paragraph", "content": "Wähle eine Hauptkollektion, dann werden Produkte aus dieser Kollektion angezeigt. Alternativ: lege eigene Kollektionen je Karte an." },
    { "type": "collection", "id": "collection", "label": "Hauptkollektion" },
    { "type": "range", "id": "products_to_show", "label": "Anzahl Produkte", "min": 3, "max": 12, "step": 1, "default": 3 },
    { "type": "select", "id": "columns", "label": "Spalten", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "header", "content": "Vergleichstabelle" },
    { "type": "checkbox", "id": "show_comparison", "label": "Vergleichsreihe anzeigen", "default": true },
    { "type": "text", "id": "compare_type", "label": "Bike type" },
    { "type": "text", "id": "compare_weight", "label": "Gewicht" },
    { "type": "text", "id": "compare_gears", "label": "Schaltung" },
    { "type": "text", "id": "compare_price", "label": "Preis" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_label", "label": "Button" },
    { "type": "url", "id": "cta_link", "label": "Button-Link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie-Bild",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Road Bikes" },
        { "type": "text", "id": "subtitle", "label": "Untertitel", "default": "Choose" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "card",
      "name": "Bike-Karte (Kollektion)",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Road" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Road Bikes" },
        { "type": "collection", "id": "collection", "label": "Kollektion" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "card", "settings": { "eyebrow": "Schnell", "title": "Road Bikes" } },
      { "type": "card", "settings": { "eyebrow": "Wild", "title": "Mountain Bikes" } },
      { "type": "card", "settings": { "eyebrow": "Vielseitig", "title": "Gravel Bikes" } }
    ]
  }
}
{% endschema %}
