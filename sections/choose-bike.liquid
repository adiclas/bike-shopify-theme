<section class="section-spacing choose-bike">
  <div class="container">
    <header class="section-heading section-heading--center">
      <p class="eyebrow">Find what you need</p>
      <h2>Choose your <span class="accent">bike</span></h2>
      <p class="section-heading__sub">Men will be Satisfy Your</p>
    </header>
    {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
      <div class="choose-bike__products product-grid product-grid--{{ section.settings.columns }}">
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <div class="choose-bike__grid">
        {% for block in section.blocks %}
          <a class="choose-bike__item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', alt: block.settings.title }}{% else %}<div class="choose-bike__placeholder"></div>{% endif %}
            <h3>{{ block.settings.title }}</h3>
            <span>{{ block.settings.subtitle }}</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}
    <div class="choose-bike__cta"><a class="button button--accent" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a></div>
  </div>
</section>

{% schema %}
{
  "name": "Bike wählen",
  "max_blocks": 3,
  "settings": [
    { "type": "header", "content": "Produkte" },
    { "type": "paragraph", "content": "Wenn eine Kollektion ausgewählt ist, werden Produkte aus dieser Kollektion angezeigt. Andernfalls erscheinen die Kategorie-Karten unten." },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "products_to_show", "label": "Anzahl Produkte", "min": 3, "max": 12, "step": 1, "default": 3 },
    { "type": "select", "id": "columns", "label": "Spalten", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Choose a Bikes" },
    { "type": "url", "id": "cta_link", "label": "Button-Link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Road Bikes" },
        { "type": "text", "id": "subtitle", "label": "Untertitel", "default": "Choose" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{
    "name": "Bike wählen",
    "blocks": [
      { "type": "category", "settings": { "title": "Road Bikes", "subtitle": "Choose" } },
      { "type": "category", "settings": { "title": "Mountain Bikes", "subtitle": "Choose" } },
      { "type": "category", "settings": { "title": "BMX Bikes", "subtitle": "Choose" } }
    ]
  }]
}
{% endschema %}
