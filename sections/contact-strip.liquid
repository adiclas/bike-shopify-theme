<section class="contact-band section-spacing">
  <div class="container contact-band__grid">
    <div class="contact-band__info">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>
    <div class="contact-band__actions">
      {% if section.settings.phone != blank %}<a class="contact-band__btn" href="tel:{{ section.settings.phone | remove: ' ' }}">📞 {{ section.settings.phone }}</a>{% endif %}
      {% if section.settings.email != blank %}<a class="contact-band__btn" href="mailto:{{ section.settings.email }}">✉ {{ section.settings.email }}</a>{% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kontakt-Band",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Du hast Fragen?" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Wir helfen dir gerne weiter – von Bike-Profis für dich." },
    { "type": "text", "id": "phone", "label": "Telefon", "default": "0 800 555 1234" },
    { "type": "text", "id": "email", "label": "E-Mail", "default": "support@bikemailorder.test" }
  ]
}
{% endschema %}
