<section class="product-feature section-spacing">
  <div class="container product-feature__grid">
    <div class="product-feature__media">
      {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600,900,1200', alt: section.settings.heading }}{% else %}<div class="product-feature__placeholder"></div>{% endif %}
    </div>
    <div class="product-feature__info">
      <p class="eyebrow">Pedal your bike</p>
      <h2>Carbon Fiber <span class="accent">{{ section.settings.brand }}</span></h2>
      <p class="product-feature__sub">Motion is the state of change of position of a body with respect to time.</p>
      <ul class="product-feature__specs">
        {% for block in section.blocks %}
          <li><strong>{{ block.settings.value }}</strong><span>{{ block.settings.label }}</span></li>
        {% endfor %}
      </ul>
      <p class="product-feature__brand">Frame: Powerlite Management</p>
      <p class="product-feature__brand">Powerful Bikes</p>
      <div class="product-feature__price"><span class="muted">Price</span><strong>${{ section.settings.price }}</strong><s>${{ section.settings.compare_at_price }}</s></div>
      <a class="button button--accent" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Produkt im Fokus",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "brand", "label": "Marke", "default": "Cervélo" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Cervélo" },
    { "type": "text", "id": "price", "label": "Preis", "default": "1150" },
    { "type": "text", "id": "compare_at_price", "label": "Streichpreis", "default": "1600" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Add to cart" }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spezifikation",
      "settings": [
        { "type": "text", "id": "value", "label": "Wert", "default": "66" },
        { "type": "text", "id": "label", "label": "Label", "default": "Speed" }
      ]
    }
  ],
  "presets": [{
    "name": "Produkt im Fokus",
    "blocks": [
      { "type": "spec", "settings": { "value": "66", "label": "Speed" } },
      { "type": "spec", "settings": { "value": "1215", "label": "Power" } },
      { "type": "spec", "settings": { "value": "3126", "label": "Torque" } },
      { "type": "spec", "settings": { "value": "1296", "label": "Range" } }
    ]
  }]
}
{% endschema %}
