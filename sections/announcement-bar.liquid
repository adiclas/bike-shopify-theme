{% if section.settings.enabled %}
  <div class="announcement-bar">
    <div class="container announcement-bar__inner">
      <span>{{ section.settings.text }}</span>
      {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{% endif %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Hinweisleiste",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Anzeigen", "default": true },
    { "type": "text", "id": "text", "label": "Text", "default": "Kostenloser Versand ab 99 € · 30 Tage Rückgaberecht" },
    { "type": "text", "id": "link_label", "label": "Linktext", "default": "Mehr erfahren" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
