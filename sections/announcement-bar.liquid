{% if section.blocks.size > 0 %}
  <div class="announcement-bar announcement-bar--carousel" data-announcement-carousel aria-label="Ankündigungen" aria-roledescription="carousel">
    <div class="container announcement-bar__inner">
      <div class="announcement-bar__slider" data-announcement-slider>
        <button type="button" class="announcement-bar__nav announcement-bar__nav--prev" data-announcement-prev aria-label="Vorherige Ankündigung">‹</button>
        <div class="announcement-bar__viewport" aria-live="polite">
          <ul class="announcement-bar__track" data-announcement-track>
            {% for block in section.blocks %}
              <li class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}" data-announcement-slide {{ block.shopify_attributes }} aria-roledescription="slide" aria-label="{{ forloop.index }} von {{ section.blocks.size }}">
                {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
                  <span class="announcement-bar__eyebrow" aria-hidden="true">{{ block.settings.eyebrow | default: 'Aktuell' }}</span>
                  <span class="announcement-bar__message">{{ block.settings.text }}</span>
                {% if block.settings.link != blank %}</a>{% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>
        <button type="button" class="announcement-bar__nav announcement-bar__nav--next" data-announcement-next aria-label="Nächste Ankündigung">›</button>
        <div class="announcement-bar__meta">
          <ol class="announcement-bar__dots" data-announcement-dots role="tablist">
            {% for block in section.blocks %}
              <li><button type="button" class="announcement-bar__dot{% if forloop.first %} is-active{% endif %}" data-announcement-index="{{ forloop.index0 }}" aria-label="Ankündigung {{ forloop.index }} anzeigen" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"></button></li>
            {% endfor %}
          </ol>
          <button type="button" class="announcement-bar__pause" data-announcement-pause aria-label="Auto-Rotate pausieren">⏸</button>
        </div>
      </div>
    </div>
  </div>
{% endif %}


<style>
  .announcement-bar--carousel .announcement-bar__inner{align-items:center;gap:14px}
  .announcement-bar__viewport{flex:1;position:relative;overflow:hidden;min-height:32px;display:flex;align-items:center}
  .announcement-bar__track{position:relative;flex:1;height:32px}
  .announcement-bar__slide{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;gap:10px;margin:0;padding:0 8px;list-style:none;opacity:0;transform:translateY(8px);transition:opacity .35s,transform .35s;pointer-events:none;color:inherit;font-size:.72rem;font-weight:500;letter-spacing:.04em}
  .announcement-bar__slide.is-active{opacity:1;transform:none;pointer-events:auto}
  .announcement-bar__slide a{display:inline-flex;align-items:center;gap:10px;color:inherit;text-decoration:none}
  .announcement-bar__slide a:hover{color:#fff;text-decoration:underline}
  .announcement-bar__eyebrow{padding:3px 8px;background:var(--color-accent);color:var(--color-header);border-radius:3px;font-size:.6rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase}
  .announcement-bar__nav{appearance:none;background:transparent;border:0;color:inherit;font-size:1.4rem;line-height:1;padding:0 6px;cursor:pointer;opacity:.7;transition:opacity .2s}
  .announcement-bar__nav:hover{opacity:1}
  .announcement-bar__meta{display:flex;align-items:center;gap:10px}
  .announcement-bar__dots{display:flex;gap:6px;margin:0;padding:0;list-style:none}
  .announcement-bar__dot{width:7px;height:7px;padding:0;border-radius:50%;background:rgba(255,255,255,.45);cursor:pointer;transition:background .2s,transform .2s}
  .announcement-bar__dot.is-active{background:#fff;transform:scale(1.3)}
  .announcement-bar__pause{appearance:none;background:transparent;border:0;color:inherit;font-size:.85rem;cursor:pointer;opacity:.7;transition:opacity .2s}
  .announcement-bar__pause:hover{opacity:1}
  @media(max-width:800px){.announcement-bar__nav{display:none}.announcement-bar__meta{display:none}.announcement-bar__slide{font-size:.66rem}}
</style>

<script>
  (function() {
    const carousel = document.querySelector('[data-announcement-carousel]');
    if (!carousel) return;
    const slides = carousel.querySelectorAll('[data-announcement-slide]');
    const dots = carousel.querySelectorAll('[data-announcement-dot]');
    const prev = carousel.querySelector('[data-announcement-prev]');
    const next = carousel.querySelector('[data-announcement-next]');
    const pause = carousel.querySelector('[data-announcement-pause]');
    if (slides.length < 2) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer = null;
    const interval = {{ section.settings.interval | default: 5 }} * 1000;
    const go = (target) => {
      index = (target + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', active ? 'false' : 'true');
      });
      dots.forEach((dot, i) => {
        const active = i === index;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-selected', active ? 'true' : 'false');
      });
    };
    const start = () => {
      stop();
      if (reduce) return;
      timer = setInterval(() => go(index + 1), interval);
      if (pause) { pause.textContent = '⏸'; pause.setAttribute('aria-label', 'Auto-Rotate pausieren'); }
    };
    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
      if (pause) { pause.textContent = '▶'; pause.setAttribute('aria-label', 'Auto-Rotate fortsetzen'); }
    };
    let touchStartX = 0;
    carousel.addEventListener('touchstart', (event) => { touchStartX = event.touches[0].clientX; stop(); }, { passive: true });
    carousel.addEventListener('touchend', (event) => {
      const diff = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(diff) > 40) go(index + (diff < 0 ? 1 : -1));
      start();
    });
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);
    if (prev) prev.addEventListener('click', () => { go(index - 1); start(); });
    if (next) next.addEventListener('click', () => { go(index + 1); start(); });
    if (pause) pause.addEventListener('click', () => { if (timer) stop(); else start(); });
    dots.forEach((dot) => dot.addEventListener('click', () => { go(parseInt(dot.dataset.announcementIndex, 10)); start(); }));
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });
    start();
  })();
</script>

{% schema %}
{
  "name": "Hinweisleiste",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "text", "label": "Fallback-Text", "default": "Kostenloser Versand ab 99 € · 30 Tage Rückgaberecht" },
    { "type": "range", "id": "interval", "label": "Rotations-Intervall (Sekunden)", "min": 2, "max": 15, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Ankündigung",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow (Tag)", "default": "Aktuell" },
        { "type": "text", "id": "text", "label": "Text", "default": "Kostenloser Versand ab 99 €" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "message", "settings": { "eyebrow": "Versand", "text": "Kostenloser Versand ab 99 € · 30 Tage Rückgaberecht", "link": "/pages/shipping" } },
      { "type": "message", "settings": { "eyebrow": "Rückgabe", "text": "30 Tage kostenlose Rückgabe", "link": "/pages/returns" } },
      { "type": "message", "settings": { "eyebrow": "Neu", "text": "Bike-Leasing bis zu 40 % sparen", "link": "/pages/bike-leasing" } }
    ]
  }
}
{% endschema %}


{% endschema %}


