<aside class="mini-cart" data-mini-cart aria-live="polite" aria-atomic="true">
  <a class="mini-cart__pill" href="{{ routes.cart_url }}" aria-label="Warenkorb anzeigen">
    <span class="mini-cart__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        <path d="M5 7h14l-1.5 10.2a2 2 0 0 1-2 1.8H8.5a2 2 0 0 1-2-1.8L5 7z"></path>
        <path d="M9 7V5a3 3 0 0 1 6 0v2"></path>
      </svg>
    </span>
    <span class="mini-cart__meta">
      <span class="mini-cart__label">Warenkorb</span>
      <span class="mini-cart__count"><b data-mini-cart-count>{{ cart.item_count }}</b> {{ cart.item_count | pluralize: 'Artikel', 'Artikel' }} · <span data-mini-cart-total>{{ cart.total_price | money }}</span></span>
    </span>
    <span class="mini-cart__arrow" aria-hidden="true">↗</span>
  </a>
</aside>

<style>
  .mini-cart{position:fixed;left:18px;bottom:18px;z-index:60;pointer-events:none}
  .mini-cart__pill{pointer-events:auto;display:flex;align-items:center;gap:12px;padding:10px 18px 10px 12px;background:#1a1a1a;color:#fff;border-radius:999px;box-shadow:0 14px 30px rgba(0,0,0,.28);text-decoration:none;font-size:.8rem;font-weight:600;line-height:1.2;transition:transform .25s,box-shadow .25s}
  .mini-cart__pill:hover{transform:translateY(-2px);box-shadow:0 18px 36px rgba(0,0,0,.32)}
  .mini-cart__icon{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--color-accent);color:#1a1a1a}
  .mini-cart__meta{display:grid;gap:2px}
  .mini-cart__label{font-size:.62rem;letter-spacing:.14em;text-transform:uppercase;color:#d6ff38}
  .mini-cart__count{font-size:.78rem;font-weight:500;color:#fff}
  .mini-cart__count b{font-weight:800}
  .mini-cart__arrow{font-size:1rem;margin-left:4px}
  .mini-cart__pill.is-pulsing{animation:mini-cart-pulse .8s ease-out}
  @keyframes mini-cart-pulse{0%{box-shadow:0 14px 30px rgba(0,0,0,.28),0 0 0 0 rgba(229,78,38,.6)}60%{box-shadow:0 14px 30px rgba(0,0,0,.28),0 0 0 22px rgba(229,78,38,0)}100%{box-shadow:0 14px 30px rgba(0,0,0,.28),0 0 0 0 rgba(229,78,38,0)}}
  .mini-cart__count b.is-pulsing{display:inline-block;animation:mini-cart-bump .55s ease-out}
  @keyframes mini-cart-bump{0%{transform:translateY(0)}40%{transform:translateY(-3px) scale(1.15)}100%{transform:translateY(0) scale(1)}}
  @media(max-width:540px){.mini-cart__meta{display:none}.mini-cart__pill{padding:10px}}
</style>

<script>
  (function() {
    const root = document.querySelector('[data-mini-cart]');
    if (!root) return;
    const pill = root.querySelector('.mini-cart__pill');
    const countEl = root.querySelector('[data-mini-cart-count]');
    const totalEl = root.querySelector('[data-mini-cart-total]');
    const formatMoney = (cents) => new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }).format((cents || 0) / 100);
    const pulse = () => {
      pill.classList.remove('is-pulsing');
      countEl.classList.remove('is-pulsing');
      void pill.offsetWidth;
      pill.classList.add('is-pulsing');
      countEl.classList.add('is-pulsing');
    };
    const apply = (data) => {
      if (!data) return;
      if (typeof data.item_count === 'number') countEl.textContent = data.item_count;
      if (typeof data.total_price === 'number') totalEl.textContent = formatMoney(data.total_price);
      pulse();
    };
    document.addEventListener('cart:change', (event) => apply(event.detail && event.detail.cart));
    document.addEventListener('DOMContentLoaded', () => {
      const live = window.Shopify && window.Shopify.cart ? window.Shopify.cart : null;
      if (live) apply({ item_count: live.item_count, total_price: live.total_price });
    });
    if (!window.Shopify || !window.Shopify.cart) {
      fetch('{{ routes.cart_url }}.js').then((r) => r.ok ? r.json() : null).then((cart) => apply(cart)).catch(() => {});
    }
  })();
</script>
