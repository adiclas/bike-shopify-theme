<article class="product-card">
  <a class="product-card__media" href="{{ product.url }}">
    {% if product.compare_at_price_max > product.price %}<span class="badge">-{{ product.compare_at_price_max | minus: product.price | times: 100.0 | divided_by: product.compare_at_price_max | round }}%</span>{% endif %}
    {% if product.featured_image != blank %}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,500,700,900', alt: product.featured_image.alt }}
      {% if product.images[1] != blank %}{{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,500,700,900', class: 'product-card__secondary', alt: product.images[1].alt }}{% endif %}
    {% else %}
      <div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
    {% endif %}
  </a>
  <div class="product-card__body">
    {% if product.vendor != blank %}<p class="product-card__vendor">{{ product.vendor }}</p>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <div class="product-card__price"><strong>{% if product.price_varies %}Ab {% endif %}{{ product.price | money }}</strong>{% if product.compare_at_price_max > product.price %}<s>{{ product.compare_at_price_max | money }}</s>{% endif %}</div>
    <div class="product-card__footer"><span>{% if product.available %}Sofort verfügbar{% else %}Ausverkauft{% endif %}</span><a href="{{ product.url }}" aria-label="{{ product.title }} ansehen">↗</a></div>
  </div>
</article>
