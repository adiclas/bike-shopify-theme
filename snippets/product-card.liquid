<article class="product-card{% unless product.available %} product-card--sold-out{% endunless %}">
  <a class="product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if product.compare_at_price_max > product.price and product.available %}
      <span class="product-card__badge">-{{ product.compare_at_price_max | minus: product.price | times: 100.0 | divided_by: product.compare_at_price_max | round }}%</span>
    {% endif %}
    {% if product.featured_image != blank %}
      {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,500,700,900', class: 'product-card__image', alt: product.featured_image.alt | default: product.title }}
      {% if product.images.size > 1 %}
        {{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,500,700,900', class: 'product-card__image product-card__image--hover', alt: product.images[1].alt | default: product.title }}
      {% endif %}
    {% else %}
      <div class="product-card__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
    {% endif %}
  </a>
  <div class="product-card__body">
    {% if product.vendor != blank %}<p class="product-card__vendor">{{ product.vendor }}</p>{% endif %}
    <h3 class="product-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="product-card__price">
      {% if product.price_varies %}Ab {% endif %}<strong>{{ product.price | money }}</strong>
      {% if product.compare_at_price_max > product.price %}<s>{{ product.compare_at_price_max | money }}</s>{% endif %}
    </p>
    <div class="product-card__footer">
      <span class="product-card__status">{% if product.available %}Sofort verfügbar{% else %}Ausverkauft{% endif %}</span>
      <a class="product-card__arrow" href="{{ product.url }}" aria-label="{{ product.title | escape }} ansehen">↗</a>
    </div>
  </div>
</article>
