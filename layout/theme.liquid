<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{% if page_title %}{{ page_title }}{% else %}{{ shop.name }}{% endif %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {% liquid
      assign body_font = settings.font_body
      assign heading_font = settings.font_heading
    %}
    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}
      :root {
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --color-background: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --color-accent: {{ settings.color_accent }};
        --color-surface: {{ settings.color_surface }};
        --color-muted: {{ settings.color_muted }};
        --color-header: {{ settings.color_header }};
        --color-header-text: #ffffff;
        --color-border: color-mix(in srgb, var(--color-text) 14%, transparent);
      }
      {% case settings.color_preset %}
        {% when 'velocity' %}
          :root { --color-background: #ffffff; --color-text: #212121; --color-accent: #e54e26; --color-surface: #f4f5f5; --color-muted: #6e7378; --color-header: #1a1a1a; --color-header-text: #ffffff; --color-script: 'Playfair Display', Georgia, serif; }
        {% when 'alpine' %}
          :root { --color-background: #f4f6f1; --color-text: #14231e; --color-accent: #c7f238; --color-surface: #ffffff; --color-muted: #64726d; --color-header: #14211e; --color-header-text: #ffffff; --color-script: 'Playfair Display', Georgia, serif; }
        {% when 'sunset' %}
          :root { --color-background: #fff8f1; --color-text: #241713; --color-accent: #e54e26; --color-surface: #ffffff; --color-muted: #806f68; --color-header: #241713; --color-header-text: #ffffff; --color-script: 'Playfair Display', Georgia, serif; }
      {% endcase %}
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-{{ template.name | handle }} color-preset-{{ settings.color_preset }}">
    <a class="skip-link" href="#MainContent">Zum Inhalt springen</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}
    {% render 'sticky-cart' %}
    {% render 'sticky-add-to-cart' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% section 'footer' %}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
